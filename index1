<body><div class="page">
<header class="masthead"><div><div class="eyebrow">MATH EXPLORATIONS / 01</div><h1>函數之間</h1><p class="intro">拖動底數，觀察指數與對數的相遇，<br>看見關於 $y=x$ 的對稱。</p></div><span class="edition">指數 × 對數 · 互動筆記</span></header>
<main class="workspace">
<section class="card graph-card" aria-label="互動探索區">
<div class="card-heading"><h2>圖形觀察</h2><span class="range-tag">x、y：−5 ～ 10 · 等比例</span></div>
<div class="legend"><span><i class="swatch"></i>$y=a^x$</span><span><i class="swatch teal"></i>$y=\log_a(x)$</span><span><i class="swatch axis"></i>$y=x$</span><span><i class="swatch point"></i>交點</span></div>
<div class="canvas-container"><canvas id="functionChart" role="img" aria-label="指數函數、對數函數及對稱線；兩軸範圍皆為負五至十。交點詳見下方資訊。"></canvas></div>

<div class="live-controls"><div class="control-top"><label class="base-label" for="baseSlider">底數 <i>a</i> <output id="baseValue" class="base-value" for="baseSlider">2.00000</output></label><p id="intersectionCountText" class="count" aria-live="polite"></p></div>
<input class="slider" type="range" id="baseSlider" min="0.01" max="3.5" step="any" value="2" aria-label="調整底數 a">
<div class="slider-labels"><span>0.01</span><span>拖動滑桿，觀察交點</span><span>3.5</span></div>
<p id="offscreenNote" class="offscreen-note"></p></div>
</section></main>
<details class="explore-more"><summary>底數快捷鍵與自動播放</summary><p class="field-caption">選一個底數，開始觀察</p><div class="presets">
<button onclick="setBase(0.01)">$0.01$</button><button onclick="setBase(critical_low)">$e^{-e}$</button><button onclick="setBase(0.5)">$1/2$</button><button onclick="setBase(1)">$1$</button><button onclick="setBase(critical_high)">$e^{1/e}$</button><button onclick="setBase(2)">$2$</button></div>
<button class="play" id="autoPlayBtn" onclick="toggleAutoPlay()"><svg id="playIcon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 3l11 7-11 7z"/></svg><span id="playBtnText">自動播放</span></button></details>
<details class="explore-more"><summary>交點座標與說明</summary><div id="statusBadge" class="status"></div><p id="intersectionCoordinates" class="coordinates"></p></details>
<details class="guide"><summary>觀念筆記 · 展開查看交點規律</summary><div class="guide-grid"><section><h3>當 $a>1$，圖形遞增</h3><ul><li>$a>e^{1/e}$：沒有交點。</li><li>$a=e^{1/e}$：相切於 $(e,e)$，恰有 1 個交點。</li><li>$1<a<e^{1/e}$：恰有 2 個交點，皆位於 $y=x$ 上；交點可能超出目前視野。</li></ul></section><section><h3>當 $0<a<1$，圖形遞減</h3><ul><li>$e^{-e}\le a<1$：恰有 1 個交點，位於 $y=x$ 上。</li><li>$0<a<e^{-e}$：恰有 3 個交點，其中 2 個關於 $y=x$ 對稱。</li><li>$a=1$：$y=1^x=1$ 仍有意義，但對數函數未定義。</li></ul></section></div></details>
<footer class="footnote">慢慢拖動，讓數學的關係浮現。</footer>
</div><script>let chartInstance = null;
        let autoPlayInterval = null;
        let autoPlayDirection = 1; // 1: 增加, -1: 減少
        const e = Math.E;
        const critical_high = Math.exp(1 / e); // e^(1/e) ≈ 1.444667826
        const critical_low = Math.exp(-e);      // e^(-e)   ≈ 0.0659880358

        // Helper to render KaTeX in specific elements
        function renderMath(element) {
            if (window.renderMathInElement && element) {
                renderMathInElement(element, {
                    delimiters: [
                        {left: "$$", right: "$$", display: true},
                        {left: "$", right: "$", display: false},
                        {left: "\\(", right: "\\)", display: false},
                        {left: "\\[", right: "\\]", display: true}
                    ],
                    throwOnError : false
                });
            }
        }

        // Render all static math on load
        function renderAllStaticMath() {
            renderMath(document.body);
        }


        // Classify by the actual base, never by a rounded display value.
        function classify(a) {
            if (!(a > 0) || a === 1) return null;
            if (a > critical_high) return 0;
            if (a === critical_high) return 1;
            if (a > 1) return 2;
            return a < critical_low ? 3 : 1;
        }

        function bisect(fn, lo, hi) {
            let flo = fn(lo);
            for (let i = 0; i < 100; i++) {
                const mid = lo + (hi - lo) / 2;
                const fm = fn(mid);
                if (fm === 0 || mid === lo || mid === hi) return mid;
                if ((fm > 0) === (flo > 0)) { lo = mid; flo = fm; }
                else hi = mid;
            }
            return (lo + hi) / 2;
        }

        function findIntersections(a) {
            const count = classify(a);
            if (count === null || count === 0) return [];
            if (a === critical_high) return [{x:e,y:e}];
            const k = Math.log(a);
            if (a > 1) {
                // t = ln(x) avoids overflow and brackets both roots independently.
                const f = t => t * Math.exp(-t) - k;
                let hi = 2;
                while (f(hi) > 0) hi *= 2;
                return [bisect(f,0,1), bisect(f,1,hi)].map(t => {
                    const x = Math.exp(t); return {x,y:x};
                });
            }
            const main = bisect(x => Math.exp(k*x)-x,0,1);
            const points = [{x:main,y:main}];
            if (count === 3) {
                // Parameterize the non-diagonal pair with t = ln(y/x) > 0.
                // This avoids confusing the nearby diagonal root with the pair.
                const b = -k;
                const c = t => t === 0 ? 1 : t / Math.expm1(t);
                const f = t => Math.log(c(t)) + c(t) + t - Math.log(b);
                let hi = 1;
                while (f(hi) < 0) hi *= 2;
                const t = bisect(f,0,hi);
                const x = c(t)/b, y = (c(t)+t)/b;
                points.push({x,y},{x:y,y:x});
            }
            return points.sort((p,q) => p.x-q.x);
        }

        const VIEW_MIN = -5, VIEW_MAX = 10;
        function generateData(a) {
            // Clip analytically at the visible boundary; sample the complete interval.
            // Mirror the same polyline so the two drawings remain exact reflections.
            const k = Math.log(a);
            let lo = VIEW_MIN, hi = VIEW_MAX;
            if (k > 0) hi = Math.min(hi, Math.log(VIEW_MAX) / k);
            if (k < 0) lo = Math.max(lo, Math.log(VIEW_MAX) / k);
            const point = x => ({x, y: Math.exp(k*x)});
            const expPoints = [point(lo)];
            function refine(left, right, depth) {
                const mid = point((left.x + right.x)/2);
                const error = Math.abs(mid.y - (left.y + right.y)/2);
                // Subpixel chord error even on large screens; no spline overshoot.
                if (depth < 22 && (error > 0.0005 || right.x-left.x > 0.04)) {
                    refine(left, mid, depth+1);
                    refine(mid, right, depth+1);
                } else expPoints.push(right);
            }
            refine(expPoints[0], point(hi), 0);
            const logPoints = a === 1 ? [] : expPoints.map(p=>({x:p.y,y:p.x})).sort((p,q)=>p.x-q.x);
            return {expPoints,logPoints,linePoints:[{x:VIEW_MIN,y:VIEW_MIN},{x:VIEW_MAX,y:VIEW_MAX}]};
        }

        function updateUI(a) {
            const label = a === critical_high ? 'e^(1/e)' : a === critical_low ? 'e^(-e)' : a.toFixed(5);
            document.getElementById('baseValue').innerText = label;
            const count = classify(a);
            const points = findIntersections(a);
            const badge = document.getElementById('statusBadge');
            badge.className = 'status';
            badge.textContent = count === null ? 'a = 1：對數函數未定義；指數函數為 y = 1' :
                a === critical_high ? '臨界底數：相切於 (e, e)' :
                count === 0 ? 'a > e^(1/e)：無交點' :
                count === 2 ? '1 < a < e^(1/e)：兩個交點皆在 y = x 上' :
                count === 3 ? '0 < a < e^(-e)：一個軸上交點與一對對稱交點' :
                'e^(-e) ≤ a < 1：一個交點，在 y = x 上';
            const offscreen = points.filter(p=>p.x < VIEW_MIN || p.x > VIEW_MAX || p.y < VIEW_MIN || p.y > VIEW_MAX).length;
            document.getElementById('intersectionCountText').textContent = count === null ?
                '交點個數：未定義' : '交點：' + count + ' 個';
            document.getElementById('offscreenNote').textContent = offscreen ? offscreen + ' 個交點在目前視野外' : '';
            document.getElementById('intersectionCoordinates').textContent = points.map(p=>
                '(' + p.x.toFixed(5) + ', ' + p.y.toFixed(5) + ')').join('、');
        }

        function toggleAutoPlay() {
            if (autoPlayInterval) {
                stopAutoPlay();
            } else {
                startAutoPlay();
            }
        }

        function startAutoPlay() {
            const slider = document.getElementById('baseSlider');
            const btnText = document.getElementById('playBtnText');
            const playIcon = document.getElementById('playIcon');
            
            btnText.innerText = "暫停播放";
            playIcon.innerHTML = `<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>`;

            // Range between 0.6 and 1.5
            const minA = 0.6;
            const maxA = 1.5;
            const step = 0.01;

            autoPlayInterval = setInterval(() => {
                let currentA = parseFloat(slider.value);
                currentA += step * autoPlayDirection;

                if (currentA >= maxA) {
                    currentA = maxA;
                    autoPlayDirection = -1;
                } else if (currentA <= minA) {
                    currentA = minA;
                    autoPlayDirection = 1;
                }

                slider.value = currentA;
                onSliderChange(currentA);
            }, 20); // 20ms per frame (1.5x faster than 30ms)
        }

        function stopAutoPlay() {
            if (autoPlayInterval) {
                clearInterval(autoPlayInterval);
                autoPlayInterval = null;
            }
            const btnText = document.getElementById('playBtnText');
            const playIcon = document.getElementById('playIcon');
            btnText.innerText = "自動播放";
            playIcon.innerHTML = `<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>`;
        }

        function initChart() {
            const ctx = document.getElementById('functionChart').getContext('2d');

            // Custom plugin to draw static coordinate text labels directly on canvas
            const pointLabelPlugin = {
                id: 'pointLabelPlugin',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const datasetIndex = 3; // Intercepts dataset
                    const meta = chart.getDatasetMeta(datasetIndex);

                    if (!meta || !meta.data) return;

                    ctx.save();
                    ctx.font = '500 11px system-ui, sans-serif';
                    ctx.fillStyle = '#454c49'; // White color for labels on canvas

                    // Label (0, 1) - Index 0
                    if (meta.data[0]) {
                        const pt0 = meta.data[0];
                        ctx.textAlign = 'right';
                        ctx.textBaseline = 'middle';
                        ctx.fillText('(0, 1)', pt0.x - 10, pt0.y);
                    }

                    // Label (1, 0) - Index 1
                    if (meta.data[1]) {
                        const pt1 = meta.data[1];
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'top';
                        ctx.fillText('(1, 0)', pt1.x, pt1.y + 10);
                    }

                    ctx.restore();
                }
            };

            chartInstance = new Chart(ctx, {
                type: 'scatter',
                plugins: [pointLabelPlugin],
                data: {
                    datasets: [
                        {
                            label: 'y = a^x',
                            data: [],
                            showLine: true,
                            borderColor: '#99765c', // neon yellow (yellow-400)
                            borderWidth: 2.5,
                            pointRadius: 0,
                            tension: 0
                        },
                        {
                            label: 'y = log_a(x)',
                            data: [],
                            showLine: true,
                            borderColor: '#507e79', // emerald green (emerald-500)
                            borderWidth: 2.5,
                            pointRadius: 0,
                            tension: 0
                        },
                        {
                            label: 'y = x',
                            data: [],
                            showLine: true,
                            borderColor: '#929591', // slate-500
                            borderWidth: 1.5,
                            borderDash: [5, 5],
                            pointRadius: 0
                        },
                        {
                            label: '截距點',
                            data: [
                                {x: 0, y: 1},
                                {x: 1, y: 0}
                            ],
                            backgroundColor: '#8d9385', // amber-500
                            borderColor: '#faf9f5',
                            borderWidth: 2,
                            pointRadius: 6,
                            pointHoverRadius: 8
                        },
                        {
                            label: '交點',
                            data: [],
                            backgroundColor: '#a86250', // rose-500
                            borderColor: '#faf9f5',
                            borderWidth: 2,
                            pointRadius: 6,
                            pointHoverRadius: 8
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { autoPadding: false, padding: {top: 8, right: 8} },
                    animation: {
                        duration: 0 // Smooth performance during slider drag
                    },
                    scales: {
                        x: {
                            type: 'linear',
                            position: 'bottom',
                            afterFit: scale => { scale.height = 42; },
                            min: VIEW_MIN,
                            max: VIEW_MAX,
                            ticks: {
                                color: '#656c67', maxTicksLimit: 5, maxRotation: 0
                            },
                            title: {
                                display: true,
                                text: 'x 軸',
                                color: '#505954', // slate-300
                                font: { weight: 'bold' }
                            },
                            grid: {
                                color: (context) => context.tick.value === 0 ? '#858d85' : '#e0e2da',
                                lineWidth: (context) => context.tick.value === 0 ? 2 : 1
                            }
                        },
                        y: {
                            afterFit: scale => { scale.width = 42; },
                            min: VIEW_MIN,
                            max: VIEW_MAX,
                            ticks: {
                                color: '#656c67', maxTicksLimit: 5, maxRotation: 0
                            },
                            title: {
                                display: true,
                                text: 'y 軸',
                                color: '#505954', // slate-300
                                font: { weight: 'bold' }
                            },
                            grid: {
                                color: (context) => context.tick.value === 0 ? '#858d85' : '#e0e2da',
                                lineWidth: (context) => context.tick.value === 0 ? 2 : 1
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 3) {
                                        return context.parsed.x === 0 ? '截距 (0, 1)' : '截距 (1, 0)';
                                    }
                                    return `${context.dataset.label}: (${context.parsed.x.toFixed(3)}, ${context.parsed.y.toFixed(3)})`;
                                }
                            }
                        },
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }

        function updateChart(a) {
            if (!chartInstance) return;

            const { expPoints, logPoints, linePoints } = generateData(a);
            const intersections = findIntersections(a);

            chartInstance.data.datasets[0].data = expPoints;
            chartInstance.data.datasets[1].data = logPoints;
            chartInstance.data.datasets[2].data = linePoints;
            chartInstance.data.datasets[4].data = intersections;
            chartInstance.data.datasets[3].data = a === 1 ? [{x:0,y:1}] : [{x:0,y:1},{x:1,y:0}];

            chartInstance.update();
        }

        function setBase(val) {
            stopAutoPlay();
            const slider = document.getElementById('baseSlider');
            slider.value = val;
            onSliderChange(val);
        }

        function onSliderChange(val) {
            const a = parseFloat(val);
            updateUI(a);
            updateChart(a);
        }

        window.onload = function() {
            initChart();
            renderAllStaticMath();

            const slider = document.getElementById('baseSlider');
            
            slider.addEventListener('input', (e) => {
                stopAutoPlay();
                onSliderChange(e.target.value);
            });

            // Initial render
            onSliderChange(slider.value);
        };
    </script></body></html>